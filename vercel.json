{
  "rewrites": [
    { "source": "/", "destination": "/public/page.html" },
    { "source": "/zh", "destination": "/public/page.html" },
    { "source": "/zh/", "destination": "/public/page.html" },
    { "source": "/en", "destination": "/public/page.html" },
    { "source": "/en/", "destination": "/public/page.html" },
    { "source": "/zh/base", "destination": "/public/index.html" },
    { "source": "/en/base", "destination": "/public/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, max-age=0" }
      ]
    }
  ]
}
